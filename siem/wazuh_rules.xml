<group name="hybrid_ids,">

    <rule id="100100" level="5">
        <decoded_as>hybrid-ids</decoded_as>
        <field name="integration">hybrid-ids</field>
        <description>
            Hybrid IDS alert received by Wazuh
        </description>
        <group>hybrid_ids,ids,</group>
    </rule>


    <rule id="100101" level="10">
        <if_sid>100100</if_sid>
        <field name="predicted_label">ANOMALY</field>
        <description>
            Hybrid ML IDS detected an anomaly
            from $(source_ip)
        </description>
        <group>hybrid_ids,attack_detection,</group>
    </rule>


    <rule id="100102" level="12">
        <if_sid>100101</if_sid>
        <field name="threat_severity">HIGH|CRITICAL</field>
        <description>
            High-risk Hybrid IDS alert detected
            from $(source_ip)
        </description>
        <group>hybrid_ids,high_risk,</group>
    </rule>


    <rule id="100103" level="14">
        <if_sid>100101</if_sid>
        <field name="threat_severity">CRITICAL</field>
        <description>
            Critical Hybrid IDS threat detected
            from $(source_ip)
        </description>
        <group>hybrid_ids,critical_threat,</group>
    </rule>

</group>
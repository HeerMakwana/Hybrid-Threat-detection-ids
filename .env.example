# Threat intelligence is disabled globally unless explicitly enabled.
THREAT_INTEL_ENABLED=false

ABUSEIPDB_ENABLED=true
ABUSEIPDB_API_KEY=

VIRUSTOTAL_ENABLED=true
VIRUSTOTAL_API_KEY=

OTX_ENABLED=true
OTX_API_KEY=

# OpenCTI is disabled by default. Set both values for a real instance.
OPENCTI_ENABLED=false
OPENCTI_URL=http://localhost:8080
OPENCTI_API_KEY=

# Reserved for the shared in-memory cache configuration.
THREAT_INTEL_CACHE_TTL_SECONDS=300